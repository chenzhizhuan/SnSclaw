# ============================================================================
#  SnSclaw 客户端部署 .env 模板
#
#  ⚠️ 部署前必须修改带 <CHANGE_ME> 的项，否则 docker compose up 会直接报错退出。
#  ⚠️ 本文件含密码，务必 chmod 600 且不要提交到 git。
#
#  说明：LLM 供应商的 API Key 不在这里配置。服务启动后在后台
#       设置 → 模型 → 添加供应商 录入，存于数据库并热加载。
# ============================================================================

# ==================== 宿主机映射端口 ====================
#
# 只影响「宿主机侧」的端口，容器内部端口是固定的（应用 18088、Postgres 5432），
# 由镜像和服务本身决定，改这里不会改容器内监听端口。
# 留空或删除则使用 docker-compose.yml 里的兜底默认值。

# 应用访问端口（浏览器打开这个端口）。容器内固定 18088。
APP_EXPOSED_PORT=19600
# 数据库对宿主暴露的端口，仅供外部客户端连库排查用；应用自身走 compose
# 网络内的 postgres:5432，与此无关。
DB_EXPOSED_PORT=19695

# ---------- 数据库（必填）----------
# DB_HOST/DB_PORT 是容器内部访问地址，固定为 postgres:5432，不要改成宿主端口。
# 宿主映射端口由 DB_EXPOSED_PORT 控制，仅供你从外部用客户端连库。
DB_HOST=postgres
DB_PORT=5432
DB_NAME=snsclaw

# 应用连接用的低权限账号（非超级用户）
DB_USERNAME=snsclaw
DB_PASSWORD=<CHANGE_ME_应用库密码>

# 超级用户，仅用于初始化和运维
DB_ADMIN_USERNAME=snsclaw_admin
DB_ADMIN_PASSWORD=<CHANGE_ME_超管库密码>

# ---------- 安全（必填）----------
# JWT 签名密钥。留空会导致每次重启后所有登录态失效。
# 生成： openssl rand -base64 48
JWT_SECRET=<CHANGE_ME_运行openssl_rand_base64_48生成>

# SearXNG 实例密钥。生成： openssl rand -hex 32
SEARXNG_SECRET=<CHANGE_ME_运行openssl_rand_hex_32生成>

# ---------- 对外访问地址（必填）----------
# ⚠️ 必须填成"浏览器实际访问这台服务的地址"，用于生成分享链接和 OAuth 回调 URL。
# 示例： http://sns.app:${APP_EXPOSED_PORT}   或   https://ai.yourdomain.com
# 端口号应与下面的 APP_EXPOSED_PORT 一致。
MATECLAW_PUBLIC_BASE_URL=<CHANGE_ME_对外访问地址_如http://IP:${APP_EXPOSED_PORT}>

# 跨域白名单，逗号分隔。单机部署且前后端同源时可留空。
MATECLAW_CORS_ALLOWED_ORIGINS=

# ---------- 可选：搜索增强 ----------
# 留空则只用内置的 SearXNG（keyless，已够用）
SERPER_API_KEY=
TAVILY_API_KEY=

# ---------- 浏览器自动化（Playwright）----------
# 内网部署建议开启 true：允许 agent 访问 192.168.x.x / 127.0.0.1 等私有地址。
# 云元数据端点仍然被拦截。公网暴露的部署保持 false。
PLAYWRIGHT_ALLOW_PRIVATE_NETWORK=true
PLAYWRIGHT_IGNORE_HTTPS_ERRORS=true
PLAYWRIGHT_DEFAULT_TIMEOUT_SECONDS=30
PLAYWRIGHT_NAVIGATION_TIMEOUT_SECONDS=30
PLAYWRIGHT_SNAPSHOT_MAX_LENGTH=20000

# 外接 Chrome（CDP）时才需要，一般留空用镜像内置 Chromium
MATECLAW_BROWSER_CDP_URL=
MATECLAW_BROWSER_CHROME_PATH=
MATECLAW_BROWSER_CHANNEL=

# ---------- OpenAI OAuth ----------
# 留空=auto：localhost 访问走 LOCAL 回调，IP/域名访问走 DEVICE_CODE。
# 若 compose 里删掉了 1455 端口映射，这里保持留空即可。
MATECLAW_OAUTH_OPENAI_DEPLOYMENT_MODE=
MATECLAW_OAUTH_OPENAI_CALLBACK_BIND_HOST=0.0.0.0

# ---------- Wiki 知识库 ----------
# 允许扫描的宿主目录白名单，逗号分隔。留空=禁止目录扫描。
# 若要启用，记得同步在 compose 的 volumes 把宿主路径挂进容器。
MATE_WIKI_ALLOWED_SOURCE_ROOTS=
MATE_WIKI_WATCHER_ENABLED=false
MATE_WIKI_WATCHER_INTERVAL_MS=300000

# ---------- Skill ----------
MATECLAW_SKILL_WORKSPACE_ROOT=/app/data/skills
MATECLAW_SKILL_UPLOAD_MAX_ENTRY_SIZE_MB=1
MATECLAW_SKILL_UPLOAD_MAX_TOTAL_SIZE_MB=50

# ---------- pip 镜像源（可选）----------
# skill 里的 Python 脚本缺包时走这个源，留空用 PyPI 官方。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=
