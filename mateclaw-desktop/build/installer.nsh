; =============================================================================
; build/installer.nsh — White-label Windows Uninstall metadata writer.
;
; Fills the "Programs and Features" (appwiz.cpl) metadata dimensions that
; Electron-Builder 25.1.8 does not yet expose as first-class nsis.* fields:
;   Publisher       → "发布者" (S&S Contributors / 发行商)
;   Comments        → "备注" (Electron workbench for the SnS runtime...)
;   HelpLink        → "支持链接"
;   URLInfoAbout    → "帮助链接"
;   URLUpdateInfo   → "更新信息"
;   ARPREADME       → Readme 链接 (详情面板中显示)
;
; Strategy — three tiers so nothing is missed:
;   Tier 1: Use the INSTALL_REGISTRY_ROOT / KEY !defines that electron-builder
;           injects into the compiled NSIS script (preferred, covers GUID case).
;   Tier 2: Fall back to BRAND_APP_ID-based subkey HKLM/HKCU
;           Software\...\Uninstall\<appId> in case tier-1 defines are absent.
;   Tier 3: Always write 64-bit + 32-bit registry views so both appwiz.cpl
;           and 32-bit inventory tools see the data.
; =============================================================================

; 1) Pull in the brand constants generated by electron-builder.cjs
!include "${BUILD_RESOURCES_DIR}\_brand_nsis_defines.nsh"

; ---------------------------------------------------------------------------
; Helper — writes one (value-name, value-data) pair to the given uninstall
; registry path using both 64-bit and 32-bit views.
;   _Root:  HKLM or HKCU
;   _Path:  "Software\Microsoft\Windows\CurrentVersion\Uninstall\XXXX"
;   _Name:  registry value name (e.g. "HelpLink")
;   _Data:  registry value data (e.g. the support URL)
; ---------------------------------------------------------------------------
!macro _WriteARPPath  _Root  _Path  _Name  _Data
  SetRegView 64
  WriteRegStr ${_Root} "${_Path}" "${_Name}" "${_Data}"
  SetRegView 32
  WriteRegStr ${_Root} "${_Path}" "${_Name}" "${_Data}"
!macroend
!define WriteARPPath '!insertmacro _WriteARPPath'

; ---------------------------------------------------------------------------
; Helper — writes all 6 metadata fields for one uninstall registry path.
; ---------------------------------------------------------------------------
!macro _WriteAllARP  _Root  _Path
  ${WriteARPPath} ${_Root} "${_Path}" "Publisher"     "${BRAND_PUBLISHER}"
  ${WriteARPPath} ${_Root} "${_Path}" "Comments"      "${BRAND_COMMENTS}"
  ${WriteARPPath} ${_Root} "${_Path}" "HelpLink"      "${BRAND_SUPPORT_URL}"
  ${WriteARPPath} ${_Root} "${_Path}" "URLInfoAbout"  "${BRAND_ABOUT_URL}"
  ${WriteARPPath} ${_Root} "${_Path}" "URLUpdateInfo" "${BRAND_UPDATE_URL}"
  ${WriteARPPath} ${_Root} "${_Path}" "ARPREADME"     "${BRAND_README_URL}"
!macroend
!define WriteAllARP '!insertmacro _WriteAllARP'

; ---------------------------------------------------------------------------
; Tier 1 write — use electron-builder's compile-time INSTALL_REGISTRY_* defs.
; The generated installer always defines these at NSIS compile-time; we wrap
; in !ifdef so the include can still be preprocessed / linted standalone.
; ---------------------------------------------------------------------------
!macro _WriteTier1
!ifdef INSTALL_REGISTRY_ROOT
!ifdef INSTALL_REGISTRY_KEY
  ${WriteAllARP} ${INSTALL_REGISTRY_ROOT} "${INSTALL_REGISTRY_KEY}"
!endif
!endif
!macroend
!define WriteTier1 '!insertmacro _WriteTier1'

; ---------------------------------------------------------------------------
; Tier 2 write — fallback using BRAND_APP_ID as the Uninstall subkey name.
; (Electron-builder actually prefers a name-based UUIDv5 GUID, but a large
;  share of tooling also looks up the appId-named key; writing both is free.)
; ---------------------------------------------------------------------------
!macro _WriteTier2
  !define /redef _ARP_SUBKEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${BRAND_APP_ID}"
  ${WriteAllARP} HKLM "${_ARP_SUBKEY}"
  ${WriteAllARP} HKCU "${_ARP_SUBKEY}"
!macroend
!define WriteTier2 '!insertmacro _WriteTier2'

; ---------------------------------------------------------------------------
; Hook — runs BEFORE the install directory page is displayed.
; Forces the install directory to %LOCALAPPDATA%\Programs\SnSclaw (per-user).
; No admin rights required.  Each Windows user gets their own independent
; copy; even if the user previously chose a custom path, this override wins.
; ---------------------------------------------------------------------------
!macro customInit
  ; $LOCALAPPDATA = C:\Users\<username>\AppData\Local (always writable by the
  ; current user; no UAC prompt needed because perMachine=false).
  StrCpy $INSTDIR "$LOCALAPPDATA\Programs\SnSclaw"
!macroend

; ---------------------------------------------------------------------------
; Hook — runs AFTER the default install section has already written its
; own Uninstall values.  Override the fields we want.
; ---------------------------------------------------------------------------
!macro customInstall
  ${WriteTier1}
  ${WriteTier2}
!macroend

; ---------------------------------------------------------------------------
; Hook — uninstall side.  Keep the registry metadata (it's diagnostic) —
; the default uninstaller removes the whole Uninstall key anyway.
; ---------------------------------------------------------------------------
!macro customUnInstall
!macroend
